{
  "name": "clint-search-scraper",
  "version": "2.0.0",
  "description": "Google Maps Lead Scraper with AI-powered search (Ollama)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node src/server/index.js\" \"vite --config frontend/vite.config.js\"",
    "start": "node src/server/index.js",
    "build": "vite build --config frontend/vite.config.js",
    "install-browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "nanoid": "^5.0.7",
    "playwright": "^1.47.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
