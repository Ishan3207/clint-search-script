# ===========================================
# Server Configuration
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# AI Provider & BYOK (Bring Your Own Key)
# ===========================================
# Active AI provider: 'ollama' (default local), 'gemini', 'openai', or 'claude'
AI_PROVIDER=ollama

# Default model override (optional - leave empty to use provider default)
# Examples:
#   Gemini: gemini-2.0-flash, gemini-1.5-flash
#   OpenAI: gpt-4o-mini, gpt-4o
#   Claude: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
AI_MODEL=

# Cloud Provider API Keys (NEVER commit actual keys! Set them in your private .env only)
# Get your keys:
#   Google Gemini:  https://aistudio.google.com/apikey
#   OpenAI:         https://platform.openai.com/api-keys
#   Anthropic:      https://console.anthropic.com/settings/keys
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Local Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ===========================================
# Scraper Engine Settings
# ===========================================
SCRAPER_CONCURRENCY=4
SCRAPER_DELAY_MIN_MS=4000
SCRAPER_DELAY_MAX_MS=8000
HEADLESS=true
